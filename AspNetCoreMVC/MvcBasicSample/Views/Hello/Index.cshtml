@*このViewがProduct型を受け取る宣言*@
@model List<MvcBasicSample.Models.Product>
@{
    ViewData["Title"] = "送料判定";  //タブ用のタイトル
    int total = 1200;
}

<h1>送料判定</h1> @*画面内の見出し*@
<p>合計 : @total 円</p>

@if (total >= 1000) {
    <p>送料無料</p>
} else {
    <p>送料がかかります</p>   
}

