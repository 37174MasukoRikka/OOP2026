@*このViewがProduct型を受け取る宣言*@
@model List<MvcBasicSample.Models.Product>
@{
    ViewData["Title"] = "合計金額";  //タブ用のタイトル
    string productName1 = "ノート";
    int price1 = 250;
    string productName2 = "ペン";
    int price2 = 150;
    int total = price1 + price2;
}

<h1>購入内容</h1> @*画面内の見出し*@
<p>@productName1 : @price1 円</p>
<p>@productName2 : @price2 円</p>
<p>合計: @total 円</p>

