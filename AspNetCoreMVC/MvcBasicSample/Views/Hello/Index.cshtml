@*このViewがProduct型を受け取る宣言*@
@model List<MvcBasicSample.Models.Product>
@{
    ViewData["Title"] = "商品一覧";  //タブ用のタイトル
    string[] products = { "ノート", "ペン", "消しゴム",};
}

<h1>商品一覧</h1> @*画面内の見出し*@
<ul>
@foreach (var product in products) 
{
    <li>@product</li>
}
</ul>


