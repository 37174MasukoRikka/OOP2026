<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeatherApp"
        mc:Ignorable="d"
        Height="600"
        Width="800">

    <Grid x:Name="MainGrid">

        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <!-- 現在の天気 -->
        <Border Grid.Row="0"
                Margin="15"
                Padding="20"
                CornerRadius="15"
                Background="White">

            <StackPanel>

                <TextBlock
                    Text="東京"
                    FontSize="28"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    x:Name="CurrentWeatherText"
                    FontSize="24"
                    FontWeight="Bold"
                    TextAlignment="Center"
                    Margin="0,10"/> 

            </StackPanel>

        </Border>

        <!-- 7日間予報 -->
        <Border Grid.Row="1"
                Margin="15"
                Padding="15"
                CornerRadius="15"
                Background="White">

            <StackPanel>

                <TextBlock
                    Text="7日間予報"
                    FontSize="22"
                    FontWeight="Bold"
                    Margin="0,0,0,10"/>

                <ListBox
                    x:Name="ForecastList"
                    FontSize="18"
                    BorderThickness="0"
                    Background="Transparent"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>